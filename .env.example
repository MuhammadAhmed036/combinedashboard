# Copy this file to .env and fill in the real values for this machine.
# Nothing in the source code is hardcoded — every host/IP/port/credential
# the app needs comes from these variables.
#
# No inline "#" comments after a value, and no quotes — the whole rest of
# the line is taken literally as the value (docker compose's env_file rule).

# Host port the dashboard is published on. deploy.sh will offer to change
# this if the port is already in use on the target VM.
APP_PORT=3000

# Set automatically by packaging/package-release.sh to match the image tag
# baked into image.tar.gz — do not change this by hand.
APP_IMAGE_TAG=0.1.0

# Same as APP_IMAGE_TAG, but for the person-count-ws image — also set
# automatically by packaging/package-release.sh, do not change by hand.
WS_IMAGE_TAG=0.1.0

# Same as APP_IMAGE_TAG/WS_IMAGE_TAG, but for the sync-service image.
SYNC_IMAGE_TAG=0.1.0

# AI / analytics (detection) backend. Served to the browser via
# /api/runtime-config, so editing this and restarting the container takes
# effect immediately — no rebuild needed. Do NOT rename this back to a
# NEXT_PUBLIC_* variable: that prefix bakes the value into the build
# permanently.
DETECTION_API_BASE_URL=http://<DETECTION_API_HOST>:18088
POLL_INTERVAL_MS=5000

# Camera list API — server only, never exposed to the browser
STREAMS_API_URL=http://<STREAMS_API_HOST>:8000/api/streams/list
STREAMS_API_USERNAME=admin
STREAMS_API_PASSWORD=change_me

# Live camera feed proxy — server only, never exposed to the browser
CAMERA_FEED_BASE_URL=http://<CAMERA_FEED_HOST>:8889
CAMERA_FEED_USERNAME=admin
CAMERA_FEED_PASSWORD=change_me

# This app's OWN local Postgres database (docker-compose service `db`, image
# postgres:16-alpine, schema in docker/init-db/). All API routes read/write
# here — never the team's DB directly. LOCAL_DB_* configure the `db` service
# and build the private `db:5432` DATABASE_URL override for the `app`,
# `person-count-ws`, and `sync` services under Docker Compose. The database
# is deliberately not published on the VM host, so it cannot collide with a
# team Postgres port. DATABASE_URL below is only for host-mode development.
LOCAL_DB_USER=dashboard
LOCAL_DB_PASSWORD=change_me
LOCAL_DB_NAME=dashboard
LOCAL_DB_PORT=5433
DATABASE_URL=postgres://dashboard:change_me@127.0.0.1:5433/dashboard

# How many raw images are kept per camera before older ones are purged —
# used to compute the camera-retention API's "remaining to target" number.
RAW_IMAGE_RETENTION_TARGET=100

# Read-only connection to the team's shared yolo_events database — used by the
# sync-service to continuously mirror detection_events and camera_locations
# into this app's own local DB. Set this to the team's main DB connection URL.
TEAM_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/yolo_events

# Person-count WebSocket this app owns directly (Media Wall live occupancy),
# served by the separate person-count-ws service. Served to the browser via
# /api/runtime-config, same as DETECTION_API_BASE_URL above — editing this
# and restarting the container takes effect immediately, no rebuild needed.
PERSON_COUNT_WS_URL=ws://<APP_HOST>:8090
PERSON_COUNT_WS_PORT=8090

# Sync service tuning. Defaults are fine for local development.
SYNC_POLL_MS=3000
SYNC_RECONCILE_MS=60000
SYNC_BATCH_LIMIT=2000
SYNC_MAX_BATCHES_PER_POLL=20
SYNC_RECONCILE_LIMIT=5000

# Person-count WebSocket polling interval.
POLL_MS=2000
