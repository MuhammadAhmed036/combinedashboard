# Copy this file to .env and fill in the real values for this machine.
# Nothing in the source code is hardcoded — every host/IP/port/credential
# the app needs comes from these variables.
#
# No inline "#" comments after a value, and no quotes — the whole rest of
# the line is taken literally as the value (docker compose's env_file rule).

# Host port the dashboard is published on. Must be different from every other
# dashboard on the VM. Until the dashboard has a sign-in, this port must only be
# reachable on the LAN (it proxies live video and frames with server-side tokens).
APP_PORT=3002

# Docker Compose project name: container names are <PROJECT_NAME>-db,
# -dashboard, -sync, -person-count-ws, -luna-ws. Must not be used by any other
# compose project on the VM.
PROJECT_NAME=combined

# Image tags for this dashboard's own images. The combined- prefix keeps them
# apart from other dashboards' safecity-* images on the same VM. The offline
# installer sets these (and POSTGRES_IMAGE) to the images in its bundle.
APP_IMAGE_TAG=combined-0.1.0
WS_IMAGE_TAG=combined-0.1.0
SYNC_IMAGE_TAG=combined-0.1.0
LUNA_WS_IMAGE_TAG=combined-0.1.0
POSTGRES_IMAGE=postgres:16-alpine

# Stage 2 detection API / event viewer. Server only: frame images and the
# camera list are fetched by this server with the token added server-side,
# never sent to the browser.
DETECTION_API_BASE_URL=http://<DETECTION_API_HOST>:18088
DETECTION_API_TOKEN=<DETECTION_API_TOKEN>
POLL_INTERVAL_MS=2000

# Streaming server stream-status API (camera list) — server only, never
# exposed to the browser. The key is bound to this server's IP on the
# streaming server: re-issue it there if this host's IP changes.
STREAMS_API_URL=http://<STREAMS_API_HOST>:8000/api/v1/stream-status
STREAMS_API_TOKEN=<STREAM_STATUS_DEVELOPER_API_KEY>

# Live camera feed (WHEP) — server only, never exposed to the browser. The
# browser sends its WebRTC offer to this app, which adds the token. The
# token is bound to this server's IP, like the stream-status key.
CAMERA_FEED_BASE_URL=http://<CAMERA_FEED_HOST>:8889
CAMERA_FEED_TOKEN=<CAMERA_FEED_BEARER_TOKEN>
CAMERA_FEED_USERNAME=<CAMERA_FEED_USERNAME>
CAMERA_FEED_PASSWORD=change_me

# This app's OWN local Postgres database (docker-compose service `db`,
# container combined-db, schema in database/init-db/). All API routes
# read/write here — never the team's DB directly. Use a new random password
# (e.g. `openssl rand -hex 24`); never reuse another dashboard's database.
# Postgres keeps the password the volume was first created with. Published
# on 127.0.0.1 only. DATABASE_URL below is only for host-mode development;
# compose builds the private db:5432 URL itself.
LOCAL_DB_USER=dashboard
LOCAL_DB_PASSWORD=change_me
LOCAL_DB_NAME=dashboard
LOCAL_DB_PORT=5370
DATABASE_URL=postgres://dashboard:change_me@127.0.0.1:5370/dashboard

# How many raw images are kept per camera before older ones are purged —
# used to compute the camera-retention API's "remaining to target" number.
RAW_IMAGE_RETENTION_TARGET=100

# Read-only connection to the team's shared yolo_events database (use the
# read-only role, e.g. dashboard_sync) — used by the sync-service to mirror
# detection_events and camera_locations into this app's own local DB.
TEAM_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:15432/yolo_events

# Person-count WebSocket (Media Wall live occupancy), served by the separate
# person-count-ws service. Leave PERSON_COUNT_WS_URL EMPTY: the browser then
# connects to ws://<page host>:PERSON_COUNT_WS_PORT, so the port is set in one
# place and works from any operator PC. Only set the URL for a different host
# (never localhost).
PERSON_COUNT_WS_URL=
PERSON_COUNT_WS_PORT=8091

# Sync service tuning. SYNC_BACKFILL_HOURS only applies to a brand-new
# deployment (no sync cursor yet): copy just the last N hours instead of the
# whole source history. Afterwards sync continues in real time from its
# saved cursor. Empty = full history.
SYNC_BACKFILL_HOURS=1
SYNC_POLL_MS=1000
SYNC_RECONCILE_MS=60000
SYNC_BATCH_LIMIT=2000
SYNC_MAX_BATCHES_PER_POLL=20
SYNC_RECONCILE_LIMIT=5000

# Person-count WebSocket polling interval.
POLL_MS=2000

# Luna Platform Configuration (Face recognition, history, events, and live stream)
LUNA_HOST=<LUNA_HOST>
LUNA_API_PORT=5000
LUNA_GATEWAY_PORT=8080
LUNA_CORE_PORT=5000
LUNA_WEB_PORT=8080
LUNA_ACCOUNT_ID=<LUNA_ACCOUNT_ID>
LUNA_AUTH_USER=<LUNA_USER>
LUNA_AUTH_PASS=<LUNA_PASSWORD>
LUNA_AUTH_METHOD=basic
LUNA_WS_PORT=8092
NEXT_PUBLIC_LUNA_WS_URL=ws://<LUNA_USER>:<LUNA_PASSWORD>@<LUNA_HOST>:5000/6/ws
NEXT_PUBLIC_LUNA_API_URL=http://<LUNA_HOST>:8080/api/lp5/6
NEXT_PUBLIC_LUNA_HOST=<LUNA_HOST>
NEXT_PUBLIC_LUNA_PORT=8080
NEXT_PUBLIC_LUNA_ACCOUNT_ID=<LUNA_ACCOUNT_ID>
NEXT_PUBLIC_LUNA_AUTH_USER=<LUNA_USER>
NEXT_PUBLIC_LUNA_AUTH_PASS=<LUNA_PASSWORD>

